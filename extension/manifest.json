{
  "manifest_version": 3,
  "name": "Taveez — Physical Lucky Charm Overlay",
  "version": "1.0.0",
  "description": "A lucky charm that hangs at the top of your browser across every webpage.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Taveez Lucky Charm"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "css": ["extension-styles.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": []
}
